{
  "name": "@dynamosql/dynamosql",
  "version": "0.0.1",
  "description": "MySQL compatible query engine with DynamoDB storage engine",
  "main": "dist/dynamosql.js",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "rollup -c",
    "lint": "eslint src test examples --fix",
    "lint:single": "eslint",
    "pretty": "prettier -u --write \"**/*\" --log-level warn",
    "ts:check": "tsc --noEmit",
    "test:export:check": "tsc --noEmit -p test/import_compare_tsconfig.json",
    "test:setup": "bash scripts/run-tests.sh setup test/setup/setup.js",
    "test:single": "bash scripts/run-tests.sh single",
    "test:single:slow": "TEST_RUN_SLOW=1 bash scripts/run-tests.sh single-slow",
    "test:slow": "TEST_RUN_SLOW=1 bash scripts/run-tests.sh slow 'test/**/*.test.js' 'test/**/*.test.ts'",
    "test": "bash scripts/run-tests.sh test 'test/**/*.test.js' 'test/**/*.test.ts'",
    "test:coverage": "TEST_RUN_SLOW=1 TEST_COVER=1 bash scripts/run-tests.sh coverage 'test/**/*.test.js'",
    "query:mysql": "dotenv -- npx tsx test/test_client.js",
    "query:session": "dotenv -- npx tsx test/test_session.js",
    "example:query": "dotenv -- node examples/query.js"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.922.0",
    "@cfworker/json-schema": "^4.1.6",
    "sqlstring": "2.3.3"
  },
  "devDependencies": {
    "@dynamosql/lint": "*",
    "@types/mysql": "^2.15.27",
    "@types/sqlstring": "^2.3.2",
    "mysql": "^2.18.1",
    "node-sql-parser": "*",
    "prettier": "^3.9.10"
  }
}
