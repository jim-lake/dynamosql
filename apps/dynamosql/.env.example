# Copy this file to .env and fill in values for your machine.
# .env is gitignored. Test scripts load it through dotenv-cli.

# AWS region for DynamoDB. Required.
AWS_REGION=us-west-2

# AWS credentials. Optional: if unset, the AWS SDK default credential chain
# is used (environment variables, ~/.aws/credentials, or an instance role).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Prefix for DynamoDB table names used by the tests. Default: dynamosql_test
DYNAMO_NAMESPACE=dynamosql_test

# MySQL server used for the comparison side of the tests. Defaults shown.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# Optional: also run tests marked slow (test:single:slow, test:quiet:slow).
# TEST_RUN_SLOW=1

# Optional: port for the debugging proxy in test/proxy.js. Default: 3306
# PORT=3306
